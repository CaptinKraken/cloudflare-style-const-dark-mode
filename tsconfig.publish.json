{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2017", "es2018.promise", "ES2021.String", "dom", "dom.iterable", "esnext.asynciterable"],
    "skipLibCheck": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "dist",
    "noImplicitAny": false,
    "paths": {}
  },
  "include": [
    "src",
    "types"
  ],
  "exclude": [
    "src/stories",
    "**/node_modules",
    "**/dist",
    "**/__tests__",
    "**/example"
  ]
}
